# Hamedis Performance Core - system properties
#
# Magisk applies these with resetprop at boot. They are overlaid, not
# written to the system partition, and disappear when the module is
# removed.
#
# DELIBERATELY CONSERVATIVE. Properties that claim to "boost FPS" by
# lying to the renderer (forcing GPU rendering of everything, disabling
# vsync, faking refresh rates) produce tearing, jank and higher power
# draw. None of those are here.

# --- Rendering -------------------------------------------------------
# Keep the render-ahead depth at the platform default. Raising it trades
# latency for smoothness and usually feels worse in games.
debug.hwui.render_dirty_regions=false

# --- Touch responsiveness -------------------------------------------
# Reduce the input event slop slightly so drags register sooner.
# This is a genuine responsiveness win with no power cost.
ro.min.fling_velocity=8000
ro.max.fling_velocity=12000

# --- Logging ---------------------------------------------------------
# Less logspam means fewer wakeups and less flash write amplification.
logd.statistics=0
ro.config.nocheckin=1
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1
persist.traced.enable=0

# --- Media -----------------------------------------------------------
# Larger audio buffers reduce CPU wakeups during gameplay. If you hear
# audio latency in rhythm games, remove these two lines.
# af.fast_track_multiplier=1
# audio_hal.period_size=192

# --- Networking ------------------------------------------------------
# Slightly larger TCP buffers help on high-latency mobile links.
net.tcp.buffersize.default=6144,87380,1048576,6144,87380,1048576
net.tcp.buffersize.wifi=6144,87380,1048576,6144,87380,1048576
net.tcp.buffersize.lte=6144,87380,1048576,6144,87380,1048576

# --- Explicitly NOT set, and why -------------------------------------
# debug.sf.hw=1                 : no effect on modern SurfaceFlinger
# debug.egl.hw=1                : no effect, cargo cult
# debug.performance.tuning=1    : not a real Android property
# video.accelerate.hw=1         : not a real Android property
# ro.ril.disable.power.collapse : harms battery, breaks modem sleep
# persist.sys.purgeable_assets  : deprecated, removed years ago
# windowsmgr.max_events_per_sec : removed in Android 4.x
