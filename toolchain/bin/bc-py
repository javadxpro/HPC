#!/usr/bin/env python3
"""bc shim for the HPC kernel build (sandbox has no bc).

Handles exactly what the 4.14 kernel needs:
  echo <HZ> | bc -q kernel/time/timeconst.bc
i.e. it implements kernel/time/timeconst.bc semantics (scale=0 integer math)
in Python. Any other bc program is rejected with a clear error.
"""
import sys


def gcd(a, b):
    while b:
        a, b = b, a % b
    return a


def fmul(b, n, d):
    return (2 ** b * n + d - 1) // d


def fadj(b, n, d):
    d = d // gcd(n, d)
    return (2 ** b * (d - 1)) // d


def fmuls(b, n, d):
    s = 0
    while True:
        if fmul(s, n, d) >= 2 ** (b - 1):
            return s
        s += 1


def main():
    data = sys.stdin.read().split()
    if not data:
        print("bc-py: no input (expected HZ on stdin)", file=sys.stderr)
        return 1
    hz = int(data[0])
    if hz < 2:
        print("#error Totally bogus HZ value!", file=sys.stderr)
        return 1

    out = []
    p = out.append
    p("/* Automatically generated by kernel/time/timeconst.bc */")
    p("/* Time conversion constants for HZ == %d */" % hz)
    p("")
    p("#ifndef KERNEL_TIMECONST_H")
    p("#define KERNEL_TIMECONST_H")
    p("")
    p("#include <linux/param.h>")
    p("#include <linux/types.h>")
    p("")
    p("#if HZ != %d" % hz)
    p('#error \\qinclude/generated/timeconst.h has the wrong HZ value!\\q')
    p("#endif")
    p("")

    def mul_adj_shr(name, n, d):
        s = fmuls(32, n, d)
        p("#define %s_MUL32\tU64_C(0x%x)" % (name, fmul(s, n, d)))
        p("#define %s_ADJ32\tU64_C(0x%x)" % (name, fadj(s, n, d)))
        p("#define %s_SHR32\t%d" % (name, s))

    mul_adj_shr("HZ_TO_MSEC", 1000, hz)
    mul_adj_shr("MSEC_TO_HZ", hz, 1000)

    cd = gcd(hz, 1000)
    p("#define HZ_TO_MSEC_NUM\t\t%d" % (1000 // cd))
    p("#define HZ_TO_MSEC_DEN\t\t%d" % (hz // cd))
    p("#define MSEC_TO_HZ_NUM\t\t%d" % (hz // cd))
    p("#define MSEC_TO_HZ_DEN\t\t%d" % (1000 // cd))
    p("")

    mul_adj_shr("HZ_TO_USEC", 1000000, hz)
    mul_adj_shr("USEC_TO_HZ", hz, 1000000)

    cd = gcd(hz, 1000000)
    p("#define HZ_TO_USEC_NUM\t\t%d" % (1000000 // cd))
    p("#define HZ_TO_USEC_DEN\t\t%d" % (hz // cd))
    p("#define USEC_TO_HZ_NUM\t\t%d" % (hz // cd))
    p("#define USEC_TO_HZ_DEN\t\t%d" % (1000000 // cd))

    cd = gcd(hz, 1000000000)
    p("#define HZ_TO_NSEC_NUM\t\t%d" % (1000000000 // cd))
    p("#define HZ_TO_NSEC_DEN\t\t%d" % (hz // cd))
    p("#define NSEC_TO_HZ_NUM\t\t%d" % (hz // cd))
    p("#define NSEC_TO_HZ_DEN\t\t%d" % (1000000000 // cd))
    p("")
    p("#endif /* KERNEL_TIMECONST_H */")

    print("\n".join(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
