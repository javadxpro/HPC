#!/usr/bin/env python3
"""PEM -> raw DER extractor (kernel extract-cert replacement, no openssl).
Empty/missing input -> empty output (no trusted certs)."""
import base64, os, re, sys
src, dst = sys.argv[1], sys.argv[2]
if not src or not os.path.exists(src):
    open(dst, "wb").close()
    sys.exit(0)
d = open(src).read()
m = re.search(r"-----BEGIN CERTIFICATE-----(.*?)-----END CERTIFICATE-----", d, re.S)
if not m:
    open(dst, "wb").close()
    sys.exit(0)
b64 = re.sub(r"\s", "", m.group(1))
open(dst, "wb").write(base64.b64decode(b64))
